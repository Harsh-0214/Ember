# --- Required ---------------------------------------------------------------
# Supabase → Project Settings → API (or "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # "anon" / publishable key (safe for the browser)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # "service_role" / secret key — SERVER ONLY, never prefix with NEXT_PUBLIC_

# USDA FoodData Central — https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# Public URL of the app (used for auth redirects / magic links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 7: web push reminders (generate with `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Optional (phase 8): natural-language / photo food logging
ANTHROPIC_API_KEY=
